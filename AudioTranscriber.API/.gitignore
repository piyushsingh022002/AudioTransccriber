#
# This file ignores folders and files generated by Visual Studio, the .NET SDK, and other tools.
#

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Tt]emp/
*.suo
*.user
*.pdb
*.suo
*.ncb
*.bak
*.cache
*.log

# Visual Studio files
.vs/
*.vssscc
*.vspscc
*.vshost.*
*.vsp
*.vspx
*.scc

# Rider IDE
.idea/

# NuGet packages
[Pp]ackages/
*.nupkg
*.snupkg

# ReSharper and other JetBrains tools
_ReSharper.*/
*.DotSettings
*.userprefs

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Azure and cloud deployment files
.azure/
*.publishsettings
*.sublime-project
*.sublime-workspace

# Other common files
Thumbs.db
[Dd]esktop.ini

# Exclude all project files from the root and then re-include them.
# This helps in case a project is nested within an excluded folder.
*.*proj
!*.*proj